 public class ZeroOrMoreParserのテスト
 {
+    [Fact]
+    public void Or派生型を反復してもoverrideを呼びます()
+    {
+        var parser = new UpperCaseOrParser();
+        var tested = new ZeroOrMoreParser<char>(parser);
+
+        var parsed = tested.Parse(new Cursol("aa!"));
+
+        parsed.Parsed.Should().Equal('A', 'A');
+        parsed.Cursol.Index.Should().Be(2);
+        parser.呼び出し回数.Should().Be(3);
+    }
+
+    [Fact]
+    public void Orの候補配列を変更すると次の反復解析で変更を使います()
+    {
+        Parser<char>[] candidates = [new CharParser('a')];
+        var tested = new ZeroOrMoreParser<char>(new OrParser<char>(candidates));
+
+        tested.Parse(new Cursol("aa!")).Parsed.Should().Equal('a', 'a');
+        candidates[0] = new CharParser('あ');
+
+        var parsed = tested.Parse(new Cursol("ああ!"));
+        parsed.Parsed.Should().Equal('あ', 'あ');
+        parsed.Cursol.Index.Should().Be(2);
+    }
+
     [Theory]
     [InlineData(0)]
     [InlineData(1)]

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Marimo.Kotowari</RootNamespace>
    <AssemblyName>Marimo.Kotowari</AssemblyName>
    <PackageId>Marimo.Kotowari</PackageId>
    <Description>A parser combinator library for C#.</Description>
    <Authors>NITTA Mitsuhiro</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HrmsTrsmgs/Kotowari</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>parser;parser-combinator;csharp;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
